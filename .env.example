# ============================================
# 金融决策系统 - 环境变量配置模板
# ============================================
#
# 使用说明:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 填入你的真实 API 密钥
# 3. 根据需要调整配置参数
#
# ⚠️  注意: .env 文件包含敏感信息，不要提交到 Git
# ============================================

# ============================================
# 🤖 LLM 模型 API 配置
# ============================================

# ---------- 阿里百炼 (推荐，国内用户) ----------
# 获取方式: https://dashscope.console.aliyun.com/
# 新用户有免费额度
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_ENABLED=true

# ---------- DeepSeek (高性价比) ----------
# 获取方式: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_ENABLED=true

# ---------- Google AI ----------
# 获取方式: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_ENABLED=true

# ---------- OpenAI ----------
# 获取方式: https://platform.openai.com/
# ⚠️  需要国外访问
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=false

# ---------- Anthropic Claude ----------
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ENABLED=false

# ---------- OpenRouter (聚合平台) ----------
# 获取方式: https://openrouter.ai/
# 一个 API 访问 60+ 模型
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_ENABLED=false

# ============================================
# 📊 数据源 API 配置
# ============================================

# ---------- FinnHub (美股数据) ----------
# 获取方式: https://finnhub.io/
# 免费版: 60 calls/minute
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_ENABLED=true

# ---------- Tushare (A股专业数据) ----------
# 获取方式: https://tushare.pro/
# 需要积分才能使用
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_ENABLED=false

# ---------- Alpha Vantage (备用数据源) ----------
# 获取方式: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_ENABLED=false

# ---------- News API (新闻数据) ----------
# 获取方式: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here
NEWS_API_ENABLED=false

# ============================================
# 🗄️ 数据库配置
# ============================================

# ---------- Redis (缓存) ----------
# 本地部署
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Docker 部署时使用
# REDIS_HOST=redis

# ---------- MongoDB (持久化) ----------
# 本地部署
MONGODB_ENABLED=true
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=financial_db

# Docker 部署时使用
# MONGODB_HOST=mongodb
# MONGODB_USERNAME=admin
# MONGODB_PASSWORD=your_secure_password

# ============================================
# ⚙️  应用配置
# ============================================

# ---------- 基础配置 ----------
APP_NAME=Financial Decision System
APP_VERSION=1.0.0
APP_ENV=development  # development, production

# ---------- 调试模式 ----------
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ---------- API 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1  # 生产环境建议 CPU 核心数 * 2

# ---------- CORS 配置 ----------
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ============================================
# 💾 缓存策略配置
# ============================================

# ---------- 缓存开关 ----------
CACHE_ENABLED=true

# ---------- 缓存过期时间 (秒) ----------
# Redis 缓存 (热点数据)
REDIS_CACHE_TTL=3600  # 1小时

# MongoDB 缓存 (历史数据)
MONGODB_CACHE_DAYS=90  # 90天

# 股票数据缓存
STOCK_DATA_CACHE_TTL=900  # 15分钟

# 新闻数据缓存
NEWS_DATA_CACHE_TTL=1800  # 30分钟

# 分析结果缓存
ANALYSIS_RESULT_CACHE_TTL=3600  # 1小时

# ============================================
# 🤖 LLM 模型默认配置
# ============================================

# ---------- 默认提供商和模型 ----------
DEFAULT_LLM_PROVIDER=dashscope
DEFAULT_LLM_MODEL=qwen-plus

# ---------- 模型角色分配 ----------
# 快速思考模型 (用于简单任务)
QUICK_THINK_LLM=qwen-turbo

# 深度思考模型 (用于复杂分析)
DEEP_THINK_LLM=qwen-plus

# 最强模型 (用于关键决策)
EXPERT_LLM=qwen-max

# ---------- 模型参数 ----------
LLM_TEMPERATURE=0.7  # 0-1, 越高越随机
LLM_MAX_TOKENS=2000  # 最大生成长度
LLM_TOP_P=0.9  # 核采样参数

# ============================================
# 📈 分析配置
# ============================================

# ---------- 智能体配置 ----------
# 默认启用的智能体
DEFAULT_AGENTS=["market", "fundamental", "news"]

# 最大并发智能体数
MAX_CONCURRENT_AGENTS=4

# ---------- 辩论配置 ----------
# 最大辩论轮次
MAX_DEBATE_ROUNDS=3

# 辩论超时时间 (秒)
DEBATE_TIMEOUT=300

# ---------- 分析深度默认值 ----------
DEFAULT_ANALYSIS_DEPTH=3  # 1-5

# ---------- 超时配置 (秒) ----------
ANALYSIS_TIMEOUT=1800  # 30分钟
AGENT_TIMEOUT=300  # 5分钟

# ============================================
# 📊 数据配置
# ============================================

# ---------- 数据更新频率 ----------
# 交易时间内的更新间隔 (秒)
TRADING_HOURS_UPDATE_INTERVAL=900  # 15分钟

# 非交易时间的更新间隔 (秒)
NON_TRADING_HOURS_UPDATE_INTERVAL=3600  # 1小时

# ---------- 数据源优先级 ----------
# 数据源按优先级排序，用逗号分隔
STOCK_DATA_PRIORITY=tushare,akshare,yfinance,finnhub

# ============================================
# 📄 报告生成配置
# ============================================

# ---------- 报告格式 ----------
REPORT_FORMATS=["markdown", "word", "pdf"]
DEFAULT_REPORT_FORMAT=markdown

# ---------- 报告模板 ----------
REPORT_TEMPLATE_DIR=./reports/templates

# ---------- 报告存储 ----------
REPORT_OUTPUT_DIR=./data/reports

# ============================================
# 🔒 安全配置
# ============================================

# ---------- API 密钥加密 ----------
# 用于加密存储的密钥
ENCRYPTION_KEY=your_random_32_character_key_here

# ---------- 访问限制 ----------
# API 调用频率限制
RATE_LIMIT_PER_MINUTE=60

# 单个用户最大并发请求
MAX_CONCURRENT_REQUESTS=5

# ---------- 会话配置 ----------
SESSION_SECRET_KEY=your_random_session_secret_key
SESSION_EXPIRE_MINUTES=1440  # 24小时

# ============================================
# 📊 监控和日志
# ============================================

# ---------- 日志配置 ----------
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ---------- 性能监控 ----------
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_FILE=./logs/performance.log

# ---------- 错误追踪 ----------
ENABLE_ERROR_TRACKING=true
ERROR_LOG_FILE=./logs/error.log

# ============================================
# 🐳 Docker 配置
# ============================================

# Docker 部署时自动使用以下配置
# REDIS_HOST=redis
# MONGODB_HOST=mongodb

# ============================================
# 🧪 测试配置
# ============================================

# 测试环境使用的配置
TEST_DATABASE=financial_test_db
TEST_REDIS_DB=1

# ============================================
# 📝 其他配置
# ============================================

# ---------- 时区 ----------
TIMEZONE=Asia/Shanghai

# ---------- 语言 ----------
DEFAULT_LANGUAGE=zh-CN

# ---------- 并发配置 ----------
MAX_WORKERS=4
ASYNC_POOL_SIZE=10

# ---------- 重试配置 ----------
MAX_RETRIES=3
RETRY_DELAY=1  # 秒

# ============================================
# 💡 使用提示
# ============================================
#
# 必需配置 (至少配置一个):
# - DASHSCOPE_API_KEY (推荐，国内用户)
# - DEEPSEEK_API_KEY
# - GOOGLE_API_KEY
# - OPENAI_API_KEY
#
# 必需配置 (数据源):
# - FINNHUB_API_KEY (美股数据)
#
# 推荐配置:
# - TUSHARE_TOKEN (A股专业数据)
# - REDIS (启用缓存，提升性能)
# - MONGODB (数据持久化)
#
# 可选配置:
# - 其他 LLM 提供商
# - 其他数据源
# - 监控和日志
#
# ============================================
